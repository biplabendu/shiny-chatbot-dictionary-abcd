# Files/directories excluded from the shinyapps.io deploy bundle.
#
# IMPORTANT: rsconnect matches lines with EXACT string comparison against the
# immediate contents of each directory. No globs, no trailing slashes, no
# nested paths. To exclude files inside a subdirectory, put another
# .rscignore there (see data/.rscignore).

# Sanity-check scripts and other dev-only tooling.
sanity-chks
.claude
.dockerignore
Dockerfile
fly.toml
clean_artifacts.sh
setup.sh
run.sh
deploy.sh
shiny-chatbot-dictionary-abcd.Rproj

# Documentation site (deployed to GitHub Pages, not shinyapps.io).
docs
mkdocs.yml
site

# Local R session state — rsconnect's hardcoded list covers .Rhistory but not .RData.
.RData

# Root-level duplicate release CSVs (dev artifacts, build inputs only) are
# excluded dynamically by deploy.sh — see data/.rscignore for details.
